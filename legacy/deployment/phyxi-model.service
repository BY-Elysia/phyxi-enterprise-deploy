[Unit]
Description=PhyXi model API and gateway
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/phyxi

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/srv/phyxi/current
ExecStart=/bin/bash /srv/phyxi/current/dc.sh up -d --wait --wait-timeout 3900 --pull never
ExecStop=/bin/bash /srv/phyxi/current/dc.sh stop -t 120
TimeoutStartSec=4000
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
